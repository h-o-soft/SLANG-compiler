  D221  32            		db	TONE.O5 + TONE.D
  D222  34            		db	TONE.O5 + TONE.E
  D223  35            		db	TONE.O5 + TONE.F
                      	
  D224  F037          		db	-16, TONE.O5 + TONE.G
  D226  F037          		db	-16, TONE.O5 + TONE.G
  D228  E037          		db	-32, TONE.O5 + TONE.G
                      	
  D22A  80            		db	0x80
                      	
                      	; o4l48dg>cfb>e
  D22B  00            	SE:	db	0
  D22C  26            		db	TONE.O4 + TONE.D
  D22D  2B            		db	TONE.O4 + TONE.G
  D22E  18            		db	TONE.O3 + TONE.C
  D22F  1D            		db	TONE.O3 + TONE.F
  D230  23            		db	TONE.O3 + TONE.B
  D231  10            		db	TONE.O2 + TONE.E
  D232  80            		db	0x80
                      	
                      	;-----------------------------------------------------------------------
                      	; ワークエリア
                      	;
  D233                	MML:
  0000                	.FREQ		equ	0		; 2 発音周波数
  0002                	.ADDRESS	equ	2		; 2 MMLデータアドレス
  0004                	.LENGTH		equ	4		; 1 現在の音長カウンタ
  0005                	.LENDATA	equ	5		; 1 音長初期値
  0006                	.REPEAT		equ	6		; 2 MMLデータ初期アドレス
  0008                	.SIZE		equ	8		; チャンネルデータサイズ
                      	
  D234                		org     ($ + 1) / 2 * 2		; 偶数アライメント
  D234                	SND:
  D234                	.Counter	ds	1		; 汎用カウンタ
  D235                	.Repeat		ds	1		; BGMリピート再生フラグ
  D236                	.CH1		ds	MML.SIZE	; 1ch
  D23E                	.CH2		ds	MML.SIZE	; 2ch
  D246                	.CH3		ds	MML.SIZE	; 3ch
  D24E                	.CHEnd		equ	$		; CH最後尾
  D24E                	.SE		ds	MML.SIZE	; SE
  D256                	.BLANKFLG	ds	1		; 垂直帰線位置フラグ
