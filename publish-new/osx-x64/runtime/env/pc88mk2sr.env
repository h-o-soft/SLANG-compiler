env_type: 0
os_type: 0
default_org:	"$1A00"
libraries:
  - runtime.yml
  - libfloat.yml
  - libp88_base.yml
  - libp88_print.yml
  - libp88_file.yml
  - libcompress.yml
  - libsoroban.yml
disk:
  format: d88
  template: ../../images/templates/PC88MK2SR.D88
  tool: udostool
  # ORG=$1A00 固定運用 (= 本 PR の制約)。SL 側で `#ORG $XXXX` 上書きすると
  # main_name (= "$1A00.$$$") と loader 期待値が不整合になり、build は通るが
  # boot しない silent wrong になる。ORG 可変化 (= main_name template 化 +
  # slangc 出力 sym からの整合 check) は次 PR で対応。
  main_name: "$1A00.$$$"      # 頭の $ も含むファイル名 (= literal、ORG hex)
  overlay_name: M{index}.BIN  # libp88_file の Disk_Load("M0 BIN", addr) で読む想定
  system_files:
    - path: ../pc88mk2sr/ipl.bin
      flag: -IPL
    - path: ../pc88mk2sr/subsys.bin
      flag: -SUB
    - path: ../pc88mk2sr/iosys.bin
      flag: -SYS
