env_type: 7
os_type: 0
default_org: "$8000"
libraries:
  - runtime.yml
  - libfloat.yml
  - libmz25iocs_print.yml
  - libmz25iocs_input.yml
disk:
  format: d88
  tool: mzd88
  title: SLANG
  main_name: PROG.obj
  main_load: "$8000"
  main_exec: "$8000"
  extra_files:
    - path: ../mz2500/J8000.bas.bsd
