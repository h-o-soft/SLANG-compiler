env_type: 5
os_type: 3
default_org:	"$C000"
output: cmt
overlay_output_format: bin
overlay_name: "M{index}.BIN"
cmt_assets:
  - ../templates/XBIOS.CMT
defines:
  PC8001_SD: 1
libraries:
  - runtime.yml
  - libfloat.yml
  - libpc80mk2xbios_base.yml
  - libpc80mk2xbios_print.yml
  - libpc80mk2xbios_input.yml
  - libpc80mk2_sound.yml
  - libcompress.yml
  - libsoroban.yml
