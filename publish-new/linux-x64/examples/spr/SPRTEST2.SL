///
/// SPRTEST2.SL — SPRLIB 色・形テスト
///
/// 3 つのスプライトを並べて表示 (各色 1 プレーン)
/// 形がどう崩れるか診断用
///

#include SPRLIB.LIB

// ============================================================
// テストパターン 1: B のみ (青) — 16x16 塗り
// ============================================================
ARRAY BYTE PAT_BLUE[] = {
	// B プレーン: 全部 $FF
	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,
	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,
	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,
	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,
	// R プレーン: 全部 $00
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	// G プレーン: 全部 $00
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00
};

// ============================================================
// テストパターン 2: R のみ (赤) — 16x16 上半分だけ
// ============================================================
ARRAY BYTE PAT_RED[] = {
	// B プレーン: 全部 $00
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	// R プレーン: 上 8 行だけ $FF
	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,
	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	// G プレーン: 全部 $00
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00
};

// ============================================================
// テストパターン 3: G のみ (緑) — 16x16 ダイヤモンド
// ============================================================
ARRAY BYTE PAT_GREEN[] = {
	// B プレーン: 全部 $00
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	// R プレーン: 全部 $00
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	$00,$00,$00,$00,$00,$00,$00,$00,
	// G プレーン: ダイヤモンド
	$01,$80, $03,$C0, $07,$E0, $0F,$F0,
	$1F,$F8, $3F,$FC, $7F,$FE, $FF,$FF,
	$FF,$FF, $7F,$FE, $3F,$FC, $1F,$F8,
	$0F,$F0, $07,$E0, $03,$C0, $01,$80
};

// ============================================================
// テストパターン 4: 白 — ダイヤモンド (全プレーン)
// ============================================================
ARRAY BYTE PAT_WHITE[] = {
	$01,$80, $03,$C0, $07,$E0, $0F,$F0,
	$1F,$F8, $3F,$FC, $7F,$FE, $FF,$FF,
	$FF,$FF, $7F,$FE, $3F,$FC, $1F,$F8,
	$0F,$F0, $07,$E0, $03,$C0, $01,$80,
	$01,$80, $03,$C0, $07,$E0, $0F,$F0,
	$1F,$F8, $3F,$FC, $7F,$FE, $FF,$FF,
	$FF,$FF, $7F,$FE, $3F,$FC, $1F,$F8,
	$0F,$F0, $07,$E0, $03,$C0, $01,$80,
	$01,$80, $03,$C0, $07,$E0, $0F,$F0,
	$1F,$F8, $3F,$FC, $7F,$FE, $FF,$FF,
	$FF,$FF, $7F,$FE, $3F,$FC, $1F,$F8,
	$0F,$F0, $07,$E0, $03,$C0, $01,$80
};

VSYNC_PROC()
{
}

MAIN()
VAR K;
{
	WIDTH(40);
	GRPSETUP();
	GRDISP(1);
	SPR_INIT();

	// スプライト 0: 青塗り (左)
	SPR_SET_PATTERN(0, PAT_BLUE);
	SPR_SET_POS(0, 4, 20);
	SPR_SET_SHOW(0, 1);

	// スプライト 1: 赤上半分 (中央)
	SPR_SET_PATTERN(1, PAT_RED);
	SPR_SET_POS(1, 20, 20);
	SPR_SET_SHOW(1, 1);

	// スプライト 2: 緑ダイヤ (右)
	SPR_SET_PATTERN(2, PAT_GREEN);
	SPR_SET_POS(2, 36, 20);
	SPR_SET_SHOW(2, 1);

	LOOP
	{
		K = INKEY(0);

		// 1: 全部白ダイヤに変更
		IF K == '1' THEN
		{
			SPR_SET_PATTERN(0, PAT_WHITE);
			SPR_SET_PATTERN(1, PAT_WHITE);
			SPR_SET_PATTERN(2, PAT_WHITE);
		}

		// 2: 元に戻す
		IF K == '2' THEN
		{
			SPR_SET_PATTERN(0, PAT_BLUE);
			SPR_SET_PATTERN(1, PAT_RED);
			SPR_SET_PATTERN(2, PAT_GREEN);
		}

		VSYNC(2);
		SPR_UPDATE();
	}
}
