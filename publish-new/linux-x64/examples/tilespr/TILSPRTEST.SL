// ============================================================
// スプライト
// ============================================================
// 16x16 ダイヤモンド (7色ストライプ)
// 行 0,1: 色1 青 (B のみ)
// 行 2,3: 色2 赤 (R のみ)
// 行 4,5: 色3 紫→黒 (B+R, パレット変更で黒表示)
// 行 6,7: 色4 緑 (G のみ)
// 行 8,9: 色5 シアン (B+G)
// 行 10,11: 色6 黄 (R+G)
// 行 12-15: 色7 白 (B+R+G)
ARRAY BYTE PLAYER[] = {
	// B プレーン
	$01,$80, $03,$C0,	// r0,1 青
	$00,$00, $00,$00,	// r2,3 赤 (Bなし)
	$1F,$F8, $3F,$FC,	// r4,5 紫→黒
	$00,$00, $00,$00,	// r6,7 緑 (Bなし)
	$FF,$FF, $7F,$FE,	// r8,9 シアン
	$00,$00, $00,$00,	// r10,11 黄 (Bなし)
	$0F,$F0, $07,$E0,	// r12,13 白
	$03,$C0, $01,$80,	// r14,15 白
	// R プレーン
	$00,$00, $00,$00,	// r0,1 青 (Rなし)
	$07,$E0, $0F,$F0,	// r2,3 赤
	$1F,$F8, $3F,$FC,	// r4,5 紫→黒
	$00,$00, $00,$00,	// r6,7 緑 (Rなし)
	$00,$00, $00,$00,	// r8,9 シアン (Rなし)
	$3F,$FC, $1F,$F8,	// r10,11 黄
	$0F,$F0, $07,$E0,	// r12,13 白
	$03,$C0, $01,$80,	// r14,15 白
	// G プレーン
	$00,$00, $00,$00,	// r0,1 青 (Gなし)
	$00,$00, $00,$00,	// r2,3 赤 (Gなし)
	$00,$00, $00,$00,	// r4,5 紫→黒 (Gなし)
	$7F,$FE, $FF,$FF,	// r6,7 緑
	$FF,$FF, $7F,$FE,	// r8,9 シアン
	$3F,$FC, $1F,$F8,	// r10,11 黄
	$0F,$F0, $07,$E0,	// r12,13 白
	$03,$C0, $01,$80	// r14,15 白
};

