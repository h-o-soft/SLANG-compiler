	$00,$00, $00,$00, $00,$00, $00,$00
};

// CONST SCREEN_W = 40;
// CONST SCREEN_H = 25;
CONST SCREEN_OFS_X = 1;
CONST SCREEN_OFS_Y = 1;
CONST SCREEN_W = 26;
CONST SCREEN_H = 22;
CONST MAP_CW = 64;
CONST MAP_CH = 64;
CONST SCROLL_MARGIN = 8;
CONST PRT_MAX = 7;

VAR I;
VAR PX, PY, SCX, SCY;

ARRAY BYTE PRT_X[PRT_MAX-1];
ARRAY BYTE PRT_Y[PRT_MAX-1];
ARRAY BYTE PRT_VX[PRT_MAX-1];
ARRAY BYTE PRT_VY[PRT_MAX-1];
ARRAY BYTE PRT_LIFE[PRT_MAX-1];


VSYNC_PROC()
{
	TILE_ANIM_TICK();
}

PARTICLE_INIT()
{
	FOR I=0 TO PRT_MAX-1
		PRT_LIFE[I] = 0;
}

PARTICLE_ADD(X, Y, VX, VY)
VAR NUM;
{
	FOR NUM=0 TO PRT_MAX-1
	{
		IF PRT_LIFE[NUM] == 0 AND SPR_IS_ACTIVE(NUM + 1) == 0
		{
			PRT_X[NUM] = X;
			PRT_Y[NUM] = Y;
			PRT_VX[NUM] = VX;
			PRT_VY[NUM] = VY;
			PRT_LIFE[NUM] = 20 + RND(20);
			IF RND(3) == 0 THEN
				SPR_SET_PATTERN(NUM + 1, BULLET_R);
			ELIF RND(2) == 0 THEN
				SPR_SET_PATTERN(NUM + 1, BULLET_Y);
			ELSE
				SPR_SET_PATTERN(NUM + 1, BULLET_C);
			SPR_SET_POS(NUM + 1, X, Y);
			SPR_SET_SHOW(NUM + 1, 1);
			RETURN;
		}
	}
}

PARTICLE_UPDATE()
VAR NX, NY;
{
	FOR I=0 TO PRT_MAX-1
	{
		IF PRT_LIFE[I] != 0
		{
			PRT_LIFE[I]--;
			IF PRT_LIFE[I] == 0 THEN
				SPR_SET_SHOW(I + 1, 0);
			ELSE
			{
				NX = (PRT_X[I] + PRT_VX[I]) AND $FF;
				NY = (PRT_Y[I] + PRT_VY[I]) AND $FF;
				// パーティクル可動域を タイル領域内 (X=1..26 chip) に制限。
				// 4dot 単位で X 右端 48 = 右端 chip 26 の位置に相当 (スプライト幅 4)。
				// UI 領域 (X=27..39 chip) にハミ出さないようにする。
				IF NX > 48 OR NY > 46
				{
					PRT_LIFE[I] = 0;
					SPR_SET_SHOW(I + 1, 0);
				}
				ELSE
				{
					PRT_X[I] = NX;
					PRT_Y[I] = NY;
					SPR_SET_POS(I + 1, NX, NY);
				}
			}
		}
	}
}

MAIN()
VAR K, SPX, SPY;
{
	WIDTH(40);
	GRPSETUP();
	GRDISP(1);
	SPR_INIT();	// doc 契約: WIDTH/GRPSETUP/GRDISP 後に呼ぶ

	// パレット変更: 色3 (紫) を黒にする
	// デフォルト: B=$AA R=$CC G=$F0 (各ビット n = 色 n の成分)
	// 色3 の B/R ビットをクリア: B=$A2, R=$C4 (G は元から0)
	#ASM
	ld bc,$1000
	ld a,$A2		; B パレット
	out (c),a
	ld bc,$1100
	ld a,$C4		; R パレット
	out (c),a
	ld bc,$1200
	ld a,$F0		; G パレット (変更なし, 念のため固定)
	out (c),a
	#END

	// TILEPCGについて8個ぶん定義
	PCGDEFS(0, TILEPCG, 8);

	TILE_INIT();
	TILE_SET_MAP(TILE_MAP, TILE_IDX, 0);
	TILE_SET_MAPSIZE(32, 32);
	TILE_SET_ANIM(4);
	TILE_SET_OFS(SCREEN_OFS_X, SCREEN_OFS_Y);
	TILE_SET_SIZE(SCREEN_W, SCREEN_H)

	PX = 20;
	PY = 20;
	SCX = 0;
	SCY = 0;

	SPR_SET_PATTERN(0, PLAYER);
	TILE_SET_ANIM_RATE(8, 4);	// アニメ進行レート: 8 vsync ごと、4 フレーム周期
	SPR_SET_SHOW(0, 1);
	PARTICLE_INIT();

	// 初回: 両ページに描画
	TILE_SET_PAGE(0);
	TILE_FILL_MAP();
	TILE_SET_PAGE(4);
	TILE_FILL_MAP();

	// --- 静的 HUD (右サイド, X=27..39) ---
	// SPR_INIT 後 / メインループ前に 1 回だけ描画。両ページに焼き付くので
	// 以降 SPR_UPDATE のページフリップで消えない。
	// UI 領域はスプライト可動範囲 (X=1..26) と分離済み。

	// HUD 外枠 (シアン)
	UI_SET_COLOR(5);
	UI_AT(27, 0);
	UI_BOX(13, 25);

	// タイトル (白)
	UI_SET_COLOR(7);
	UI_AT(30, 1);
	UI_PUTS("TILSPR");

	// SCORE (黄)
	UI_SET_COLOR(6);
	UI_AT(29, 4);
	UI_PUTS("SCORE");
	UI_SET_COLOR(7);
	UI_AT(29, 5);
	UI_PUTS("12345");

	// POWER (赤)
	UI_SET_COLOR(2);
	UI_AT(29, 8);
	UI_PUTS("POWER");
	UI_SET_COLOR(7);
	UI_AT(29, 9);
	UI_PUTS("77");

	// キーバインド (緑)
	UI_SET_COLOR(4);
	UI_AT(28, 19);
	UI_PUTS("CURSOR:MOVE");
	UI_AT(28, 21);
	UI_PUTS("P:SHOT");
	UI_AT(28, 22);
	UI_PUTS("SP:RND");

	// --- PCG 重ね UI テスト (タイル領域の上部に不透明メッセージボックス) ---
	// 既に #ASM でパレット 3 を黒にリマップ済み (色 3 = 見た目の黒)。
	// 手順: UI_FILL (色3=黒) で不透明背景 → UI_BOX で白枠 → UI_PUTS で文字。

	UI_SET_COLOR(3);
	UI_AT(3, 1);
	UI_FILL(18, 4);          // 18x4 の不透明な黒背景

	UI_SET_COLOR(7);
	UI_AT(3, 1);
	UI_BOX(18, 4);           // 白枠 (内部は FILL 済みの黒が残る)

	UI_SET_COLOR(7);
	UI_AT(5, 2);
	UI_PUTS("HELLO PCG");
	UI_AT(5, 3);
	// PCG 重ねテスト用メッセージ (color 3 を黒に remap 済の紫で背景を塗る)
	UI_PUTS("MSG ON TILE");

	LOOP
	{
		K = INKEY(0);

		IF K == 29 AND PX > SCREEN_OFS_X THEN PX-=2;
		ELIF K == 28 AND PX < MAP_CW * 2 - 4 THEN PX+=2;
		IF K == 30 AND PY > SCREEN_OFS_Y THEN PY-=2;
		ELIF K == 31 AND PY < MAP_CH * 2 - 4 THEN PY+=2;

		IF PX/2 > SCX + SCREEN_W - SCROLL_MARGIN THEN SCX = PX/2 - (SCREEN_W - SCROLL_MARGIN);
		IF PX/2 < SCX + SCROLL_MARGIN AND SCX > 0 THEN SCX = PX/2 - SCROLL_MARGIN;
		IF PY/2 > SCY + SCREEN_H - SCROLL_MARGIN THEN SCY = PY/2 - (SCREEN_H - SCROLL_MARGIN);
		IF PY/2 < SCY + SCROLL_MARGIN AND SCY > 0 THEN SCY = PY/2 - SCROLL_MARGIN;
		IF SCX >= $8000 THEN SCX = 0;
		IF SCY >= $8000 THEN SCY = 0;
		IF SCX > MAP_CW - SCREEN_W THEN SCX = MAP_CW - SCREEN_W;
		IF SCY > MAP_CH - SCREEN_H THEN SCY = MAP_CH - SCREEN_H;

		SPX = PX - SCX * 2;
		SPY = PY - SCY * 2;
		SPR_SET_POS(0, SPX, SPY);

		IF K == 'P' THEN
		{
			PARTICLE_ADD(SPX, SPY, 1, 0);
			PARTICLE_ADD(SPX, SPY, -1, 0);
			PARTICLE_ADD(SPX, SPY, 0, 1);
			PARTICLE_ADD(SPX, SPY, 0, -1);
		}
		IF K == ' ' THEN
			PARTICLE_ADD(SPX, SPY, -1 + RND(3), -1 + RND(3));

		PARTICLE_UPDATE();

		// SPRLIB の現在の描画ページに同期してタイル描画
		// (dirty 機構により、変化なしフレームは TILE_FILL_MAP がスキップされる)
		TILE_SET_SCROLL(SCX, SCY);
		TILE_SYNC_SPR_PAGE();
		TILE_FILL_MAP();

		VSYNC(2);
		SPR_UPDATE();
	}
}
