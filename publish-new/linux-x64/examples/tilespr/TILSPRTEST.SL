///
/// TILSPRTEST.SL — TILELIB + SPRLIB + UILIB 3 層統合デモ
///
/// PCG タイル背景 (8dot スクロール + アニメ)
///   + スプライト (プレイヤー + パーティクル, ダブルバッファ)
///   + 右サイドに静的 HUD (UILIB, 両ページ焼き付け)
///
/// UI 領域 (X=27..39) とスプライト可動範囲 (X=1..26) を分離している。
///

// TILELIB + SPRLIB 統合 shim
#include TILESPR.LIB
// 静的 HUD (GVRAM に直接書き込む)
#include UILIB.LIB

// ============================================================
// PCG タイル (BRG インターリーブ, 各タイル 24 バイト)
// ============================================================
