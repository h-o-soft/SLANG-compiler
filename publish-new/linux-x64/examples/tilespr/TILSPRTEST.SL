	$00,$00, $00,$00, $00,$00, $00,$00,
	$3C,$00, $7E,$00, $7E,$00, $3C,$00,
	$3C,$00, $7E,$00, $7E,$00, $3C,$00,
	$00,$00, $00,$00, $00,$00, $00,$00
};

ARRAY BYTE BULLET_R[] = {
	$00,$00, $00,$00, $00,$00, $00,$00,
	$00,$00, $00,$00, $00,$00, $00,$00,
	$00,$00, $00,$00, $00,$00, $00,$00,
	$00,$00, $00,$00, $00,$00, $00,$00,
	$00,$00, $00,$00, $00,$00, $00,$00,
