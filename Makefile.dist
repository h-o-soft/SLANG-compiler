# SLANG Compiler Makefile (Distribution Package)
# ===============================================
# make install      - バイナリとライブラリをインストール
# make uninstall    - アンインストール
# make run          - サンプルをビルドしてエミュレータで実行
# make clean        - サンプルのビルド成果物を削除

# インストール設定
# default はユーザーローカル (= sudo 不要)。Linux/macOS 共に XDG Base Dir Spec の
# ~/.local/bin に bin、~/.config/SLANG に lib/runtime/images/tools を入れる。
# システムワイドにしたい場合は `make install PREFIX=/usr/local` で上書き可能だが、
# その場合は sudo が必要 + CONFIG_DIR=$(HOME)/.config/SLANG が sudo 起動の HOME=/root
# に取られる問題があるため、`sudo make install PREFIX=/usr/local CONFIG_DIR=/usr/local/share/slang`
# のように CONFIG_DIR も明示する運用を docs で案内 (system-wide は上級ユーザー向け)。
ifeq ($(OS),Windows_NT)
    PREFIX ?= $(LOCALAPPDATA)\Programs\SLANG
    BINDIR = $(PREFIX)
    CONFIG_DIR = $(USERPROFILE)\.config\SLANG
else
    PREFIX ?= $(HOME)/.local
    BINDIR = $(PREFIX)/bin
    CONFIG_DIR = $(HOME)/.config/SLANG
endif

# サンプルビルド設定
SRC_EXT = .SL
ASM_EXT = .ASM
BIN_EXT = .bin

ENV ?= lsx
SLANGENV = $(ENV)
TARGET ?= examples/STARS
# Windows ユーザーが TARGET=examples\MODTEST_RESIDENT のように \ で渡しても
# 内部 ($(dir) 等) は / 前提なので、ここで normalize する。
# `override` を付けないと command-line 値 (= make TARGET=...) を上書きできない。
override TARGET := $(subst \,/,$(TARGET))

# OS検出
ifeq ($(OS),Windows_NT)
    DETECTED_OS = Windows
    MKDIR = mkdir
    RM = del /Q
    RMDIR = rmdir /S /Q
    CP = copy
    XCOPY = xcopy /E /Y
    PATHSEP = \\
    EXE_EXT = .exe
    PYTHON ?= python
else
    UNAME_S := $(shell uname -s)
    ifeq ($(UNAME_S),Darwin)
        DETECTED_OS = macOS
    else
        DETECTED_OS = Linux
    endif
    MKDIR = mkdir -p
    RM = rm -f
    RMDIR = rm -rf
    CP = cp
    XCOPY = cp -R
    PATHSEP = /
    EXE_EXT =
    PYTHON ?= python3
endif

# ツールのコマンド名
SLANGC = bin/slangc$(EXE_EXT)
SLANGBUILD = bin/slangbuild$(EXE_EXT)
ASM = tools/AILZ80ASM$(EXE_EXT)
NDC = tools/ndc$(EXE_EXT)
# HuDisk は ho-ogino/HuDisk fork の .NET assembly (HuDisk.exe)。
# Linux/macOS では mono 経由で起動するが、その分岐は slangbuild の ToolResolver
# 側に閉じている (= Makefile からは OS によらず .exe 拡張子で渡す)。
HUDISK = tools/HuDisk.exe

OUTPROG = $(dir $(TARGET))PROG.bin
ASM_OPT =

# エミュレータ設定（環境に応じて変更）
ifeq ($(ENV), lsx)
  EMU = @echo "Set EMU variable for your emulator" \#
  DISK_IMAGE = images/LSXPROG.d88
  BIN_EXT_ENV = .com
else ifeq ($(ENV), x1)
  EMU = @echo "Set EMU variable for your emulator" \#
  DISK_IMAGE = images/LSXPROG.d88
  BIN_EXT_ENV = .com
else ifeq ($(ENV), sos)
  EMU = @echo "Set EMU variable for your emulator" \#
  DISK_IMAGE = images/SOSPROG.D88
  BIN_EXT_ENV = $(BIN_EXT)
else ifeq ($(ENV), sosx1)
  EMU = @echo "Set EMU variable for your emulator" \#
  DISK_IMAGE = images/SOSPROG.D88
  BIN_EXT_ENV = $(BIN_EXT)
else ifeq ($(ENV), msxrom)
  EMU = @echo "Set EMU variable for your emulator" \#
  BIN_EXT_ENV = $(BIN_EXT)
  EMUOPT = -cart
  DISK_IMAGE = $(OUTPROG)
else ifeq ($(ENV), msx2)
  EMU = @echo "Set EMU variable for your emulator" \#
  DISK_IMAGE = images/dosformsx.dsk
  BIN_EXT_ENV = .com
  EMUOPT = -diska
else ifeq ($(ENV), cpm)
  SLANGENV = cpm
  ifeq ($(OS),Windows_NT)
    EMU = tools\runcpm.bat
  else
    EMU = ./tools/runcpm.sh
  endif
  DISK_IMAGE = $(OUTPROG)
  BIN_EXT_ENV = .com
endif

IMGPROG = $(basename $(OUTPROG))$(BIN_EXT_ENV)

.PHONY: all install uninstall run build clean help setup-tools

all: help

# インストール
install: install-bin install-lib
	@echo "Installation complete!"
	@echo "  Binaries: $(BINDIR)"
	@echo "  Libraries: $(CONFIG_DIR)"
ifeq ($(OS),Windows_NT)
	@echo ""
	@echo "Note: Please ensure '$(BINDIR)' is in your PATH."
else
	@echo ""
	@echo "Note: If '$(BINDIR)' is not on your PATH, add this to your shell rc:"
	@echo "  export PATH=\"$(BINDIR):\$$PATH\""
endif

install-bin:
ifeq ($(DETECTED_OS),Windows)
	@echo "Windows: Please add bin directory to PATH manually"
	-$(MKDIR) "$(BINDIR)"
	$(CP) bin\slangc.exe "$(BINDIR)\"
	$(CP) bin\slangbuild.exe "$(BINDIR)\"
else
	$(MKDIR) $(BINDIR)
	$(CP) bin/slangc $(BINDIR)/
	$(CP) bin/slangbuild $(BINDIR)/
	chmod +x $(BINDIR)/slangc
	chmod +x $(BINDIR)/slangbuild
endif

install-lib:
ifeq ($(DETECTED_OS),Windows)
	-$(MKDIR) "$(CONFIG_DIR)"
	-$(MKDIR) "$(CONFIG_DIR)\include"
	-$(MKDIR) "$(CONFIG_DIR)\runtime"
	-$(MKDIR) "$(CONFIG_DIR)\images"
	-$(MKDIR) "$(CONFIG_DIR)\images\templates"
	-$(MKDIR) "$(CONFIG_DIR)\tools"
	$(XCOPY) include "$(CONFIG_DIR)\include"
	$(XCOPY) runtime "$(CONFIG_DIR)\runtime"
	$(XCOPY) images "$(CONFIG_DIR)\images"
	$(XCOPY) tools "$(CONFIG_DIR)\tools"
else
	$(MKDIR) $(CONFIG_DIR)
	$(XCOPY) include $(CONFIG_DIR)/
	$(XCOPY) runtime $(CONFIG_DIR)/
	$(XCOPY) images $(CONFIG_DIR)/
	$(XCOPY) tools $(CONFIG_DIR)/
endif

# アンインストール
uninstall:
ifeq ($(DETECTED_OS),Windows)
	$(RM) "$(BINDIR)\slangc.exe"
	$(RM) "$(BINDIR)\slangbuild.exe"
	$(RMDIR) "$(CONFIG_DIR)"
else
	$(RM) $(BINDIR)/slangc
	$(RM) $(BINDIR)/slangbuild
	$(RMDIR) $(CONFIG_DIR)
endif
	@echo "Uninstallation complete!"

# 開発ツールのセットアップ
setup-tools:
ifeq ($(DETECTED_OS),Windows)
	setupenv.bat
else ifeq ($(DETECTED_OS),macOS)
	./setupenv.sh mac
else
	./setupenv.sh linux
endif

# サンプルのビルド
# slangbuild が slangc 呼び出し → main アセンブル → 各 overlay の filtered sym 生成
# → overlay アセンブル を一括処理する。overlay 不要 (#MODULE 未使用) の場合は
# 単段フローで main.bin だけが出る。--asm/--slangc を明示指定して PATH 上の
# 旧バイナリ混入を防ぐ。
$(OUTPROG): $(TARGET)$(SRC_EXT)
	$(SLANGBUILD) $< -E $(SLANGENV) -I include --slangc $(SLANGC) --asm $(ASM) -o $(dir $(TARGET))PROG


# ディスクイメージ作成
ifeq ($(ENV), cpm)
disk_image: $(OUTPROG)
else ifeq ($(ENV), msxrom)
disk_image: $(OUTPROG)
else ifeq ($(ENV), sos)
# Issue #157 Phase 2: sos も slangbuild --emit disk + HuDisk 経路に統合。
# template (= images/templates/SOSPROG.D88) は setup-tools で生成済 (= 素 boot
# disk + AUTOEXEC.BAT)。slangbuild が template をコピーしてから main + overlay
# を書き込む (template 自体は不変、Linux/macOS は HuDisk.exe を mono 経由で起動)。
disk_image: $(TARGET)$(SRC_EXT)
	$(SLANGBUILD) $< -E $(SLANGENV) -I include \
		--slangc $(SLANGC) --asm $(ASM) --hudisk $(HUDISK) \
		-o $(dir $(TARGET))PROG --emit disk --disk-image $(DISK_IMAGE)
else ifeq ($(ENV), sosx1)
disk_image: $(TARGET)$(SRC_EXT)
	$(SLANGBUILD) $< -E $(SLANGENV) -I include \
		--slangc $(SLANGC) --asm $(ASM) --hudisk $(HUDISK) \
		-o $(dir $(TARGET))PROG --emit disk --disk-image $(DISK_IMAGE)
else ifeq ($(ENV), lsx)
# Issue #157 Phase 1: `slangbuild --emit disk` に統合 (lsx / x1 のみ)。
# 1 コマンドで slangc → AILZ80ASM → template d88 を $(DISK_IMAGE) にコピー →
# ndc P で main + overlay 書き込みまで完結する。template / 内部ファイル名
# (PROG.COM / M0.BIN..) は env file の `disk:` セクションが規定。
disk_image: $(TARGET)$(SRC_EXT)
	$(SLANGBUILD) $< -E $(SLANGENV) -I include \
		--slangc $(SLANGC) --asm $(ASM) --ndc $(NDC) \
		-o $(dir $(TARGET))PROG --emit disk --disk-image $(DISK_IMAGE)
else ifeq ($(ENV), x1)
disk_image: $(TARGET)$(SRC_EXT)
	$(SLANGBUILD) $< -E $(SLANGENV) -I include \
		--slangc $(SLANGC) --asm $(ASM) --ndc $(NDC) \
		-o $(dir $(TARGET))PROG --emit disk --disk-image $(DISK_IMAGE)
else
# その他 d88 系 (msx2 / msxlsx / pc80mk2 / pc88mk2sr 等): 未統合 env は
# 従来の ndc P + Python helper 経路を維持。今後 env ごとに `disk:` セクション
# を追加して順次新 `slangbuild --emit disk` 経路へ移行する。
ADD_OVERLAYS = $(PYTHON) tools/disk-add-overlays.py

disk_image: $(IMGPROG)
	- $(NDC) D $(DISK_IMAGE) 0 PROG$(BIN_EXT_ENV)
	$(NDC) P $(DISK_IMAGE) 0 $(IMGPROG)
	$(ADD_OVERLAYS) $(NDC) $(DISK_IMAGE) $(dir $(TARGET))
endif

# 拡張子変換
ifneq ($(BIN_EXT), $(BIN_EXT_ENV))
$(basename $(OUTPROG))$(BIN_EXT_ENV): $(OUTPROG)
ifeq ($(OS),Windows_NT)
	move $(subst /,\,$<) $(subst /,\,$@)
else
	mv $< $@
endif
endif

# サンプル実行
ifeq ($(ENV), cpm)
# cpm: RunCPM ラッパーに .bin (or .com) を直接渡す
ifeq ($(OS),Windows_NT)
run: $(OUTPROG)
	$(EMU) $(subst /,\,$<)
else
run: $(OUTPROG)
	$(EMU) $<
endif
else
run: disk_image
	$(EMU) $(EMUOPT) $(DISK_IMAGE)
endif

# ビルドのみ
build: $(OUTPROG)

# クリーンアップ
clean:
ifeq ($(OS),Windows_NT)
	-del /Q /F $(subst /,\,$(TARGET)$(ASM_EXT)) $(subst /,\,$(TARGET)$(BIN_EXT)) $(subst /,\,$(dir $(TARGET))PROG.bin) $(subst /,\,$(dir $(TARGET))PROG.com) 2>nul
	@REM disk-add-overlays.py の staging dir は通常 finally で消えるが念押し
	-rmdir /S /Q $(subst /,\,$(dir $(TARGET)).staging) 2>nul
else
	rm -f $(TARGET)$(ASM_EXT) $(TARGET)$(BIN_EXT) $(TARGET)$(BIN_EXT_ENV) $(dir $(TARGET))PROG.bin $(dir $(TARGET))PROG.com
	@# disk-add-overlays.py の staging dir は通常 finally で消えるが念押し
	-rm -rf $(dir $(TARGET)).staging
endif

# ヘルプ
help:
	@echo "SLANG Compiler - Distribution Package"
	@echo ""
	@echo "Installation:"
	@echo "  make install       - Install binaries and libraries"
	@echo "  make uninstall     - Uninstall"
	@echo "  make setup-tools   - Download development tools (AILZ80ASM, etc.)"
	@echo ""
	@echo "Sample Build:"
	@echo "  make run TARGET=examples/STARS ENV=lsx  - Build and run sample"
	@echo "  make build TARGET=examples/STARS ENV=lsx - Build only"
	@echo "  make clean         - Clean build artifacts"
	@echo ""
	@echo "Options:"
	@echo "  PREFIX=path        - Installation prefix (default: ~/.local on Unix,"
	@echo "                       %LOCALAPPDATA%\\Programs\\SLANG on Windows)"
	@echo "  TARGET=path        - Sample source file (without extension)"
	@echo "  ENV=env            - Target environment (lsx/x1/sos/sosx1/msx2/msxrom/cpm)"
	@echo ""
	@echo "Detected OS: $(DETECTED_OS)"
