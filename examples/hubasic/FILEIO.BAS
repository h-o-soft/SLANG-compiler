10 REM FILEIO.BAS - FILE TEST (GREET.TXT IS ADDED TO THE DISK)
20 OPEN "I",#1,"GREET.TXT"
30 IF EOF(1) THEN 60
40 LINE INPUT #1,A$:PRINT A$
50 GOTO 30
60 CLOSE #1
70 OPEN "O",#2,"OUT.TXT"
80 PRINT #2,"SAVED";123
90 CLOSE #2
100 OPEN "I",#1,"OUT.TXT"
110 LINE INPUT #1,B$:PRINT B$
120 CLOSE #1
130 END
