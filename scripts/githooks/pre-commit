#!/bin/sh
# SLANG-compiler pre-commit hook: 大量 file 巻込防止
#
# PR #215 で `git add -A` 事故 (= 1166 file 巻込、 第三者 IP / backup 含む) が
# 起きたため、 50 file 超の staged commit を reject する safety net。 通常 PR
# では多くて 20-30 file、 50 超は明らかに「全部 add してしまった」 状態。
#
# Setup (= 一度だけ):
#   git config core.hooksPath scripts/githooks
#
# 意図的な大量 commit (= initial commit / 大規模 refactor 等) は
# `git commit --no-verify` で bypass 可能、 ただし全 file の origin を
# `git diff --cached --stat` で必ず確認すること。

STAGED_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')

if [ "$STAGED_COUNT" -gt 50 ]; then
    cat >&2 <<EOF
ERROR: pre-commit hook: $STAGED_COUNT files staged (threshold = 50).

This is likely an accidental \`git add -A\` / \`git add .\` capture.
Review staged files:
  git diff --cached --stat

If intentional (= initial commit / massive refactor), bypass with:
  git commit --no-verify

To unstage everything and start over:
  git reset HEAD
EOF
    exit 1
fi

# リポジトリに入れないファイルが混ざらないための検査 (Hu-BASIC の変換を同梱したときに足した)
#  1. .gitignore で除外しているファイルを新しく足す・改名で持ち込むのを止める (git add -f の保険)
#  2. 拡張子 bas・asc・d88・2d (大文字小文字を問わない) のファイルを足す・改名するのは examples/hubasic/ の中だけ
#     (既存の追跡済みファイルの変更と、削除は止めない)
#  3. examples/hubasic/ の中のファイル (README.md・MANIFEST.txt を除く) と、stage した MANIFEST.txt の名前の一覧が一致すること
#  パスは core.quotePath=false で引用符なしに読む (日本語の名前もそのまま)。それでも引用符で囲まれるパス (タブ・改行・
#  " や \ を含むもの) は、検査をすり抜けないように止める
SAMPLES=examples/hubasic
GIT="git -c core.quotePath=false"
# 除外の判定は stage した .gitignore で行う (作業ツリーの .gitignore だけを変えて抜けられないように)。
# stage した .gitignore を一時ディレクトリに出し、そこを作業ツリーとして check-ignore する
IGN_TREE=$(mktemp -d)
trap 'rm -rf "$IGN_TREE"' EXIT
$GIT ls-files --cached -- .gitignore '*/.gitignore' | git checkout-index --prefix="$IGN_TREE/" --stdin
GIT_DIR_ABS=$(git rev-parse --absolute-git-dir)
BAD=$($GIT diff --cached --name-status -M -C | awk -F '\t' '
    $1 ~ /^[RC]/ { print "N\t" $3; next }
    $1 ~ /^A/    { print "N\t" $2; next }
    $1 ~ /^M/    { print "M\t" $2 }' | while IFS="$(printf '\t')" read -r st p; do
    case "$p" in
        \"*) echo "  $p (特別な文字を含むパスは commit できません)"; continue ;;
    esac
    [ "$st" = "N" ] || continue
    if git -C "$IGN_TREE" --git-dir="$GIT_DIR_ABS" --work-tree="$IGN_TREE" -c core.excludesFile=/dev/null \
            check-ignore -q --no-index -- "$p"; then
        echo "  $p (.gitignore で除外しているファイル)"; continue
    fi
    ext=$(printf '%s' "${p##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        bas|asc|d88|2d)
            case "$p" in
                "$SAMPLES"/*) ;;
                *) echo "  $p (BASIC・ディスクイメージを足せるのは $SAMPLES/ の中だけ)" ;;
            esac ;;
    esac
done)
if $GIT diff --cached --name-only --no-renames | grep -q "^\"\{0,1\}$SAMPLES/"; then
    FILES=$($GIT ls-files --cached -- "$SAMPLES" | sed "s|^$SAMPLES/||" | grep -v -x -e README.md -e MANIFEST.txt | sort)
    LISTED=$(git show ":$SAMPLES/MANIFEST.txt" 2>/dev/null | grep -v '^#' | grep -v '^[[:space:]]*$' | cut -f1 | sort)
    if [ "$FILES" != "$LISTED" ]; then
        BAD="$BAD
  $SAMPLES/ のファイルと MANIFEST.txt の一覧が一致しません
    ファイル: $(echo $FILES)
    一覧:     $(echo $LISTED)"
    fi
fi
if [ -n "$BAD" ]; then
    echo "ERROR: pre-commit hook: リポジトリに入れないファイルが混ざっているかもしれません:" >&2
    echo "$BAD" >&2
    echo "" >&2
    echo ".gitignore で除外しているファイルは commit しません。サンプルの BASIC は $SAMPLES/ に置き、" >&2
    echo "$SAMPLES/MANIFEST.txt に名前と出どころを書いてください (このリポジトリのために新しく書いたものだけ)。" >&2
    exit 1
fi
