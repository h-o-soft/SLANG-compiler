; ====================================================================================================
; divmod_12_opm_x1.inc — X1 FM クロック (4MHz) 向けピッチ補正テーブル (refs/banjo 不改変)
;
; banjo の OPM ピッチは note 番号 → KC (YM2151 key code) を music_divmod12_opm テーブルで引いて
; 決める。 KC は「音名」を指定するだけのクロック非依存コードで、 実周波数は YM2151 のクロックで
; 決まる。 banjo の元テーブル (refs/banjo/music_driver/opm/divmod_12_opm.inc) は YM2151 = 3.58MHz
; (3,579,545 Hz、 json2sms.py:154 の定数) 前提。
;
; X1 の FM 音源ボードは YM2151 = 4MHz 駆動なので、 同じ KC でも 4 / 3.579545 = 1.117 倍 ≈ +1.92
; 半音 高く鳴る。 これを補正するため、 テーブルを **2 半音下げて**おく (= note N に対し元 note N-2 の
; KC を返す)。 残差 = 2 - 1.92 = 0.08 半音 ≈ 8 cents flat (= ほぼ可聴閾下)。
;
; これは「テーブルごと書き換え」方式なので実行時コスト・データ量とも元と同一 (= 128 byte lookup の
; まま、 動的計算なし)。 banjo_opm_x1.asm が refs の divmod_12_opm.inc の代わりに本 file を include
; する。 ラベル名は refs と同じ music_divmod12_opm (= update_pitch_registers_opm が参照)。
;
; 元テーブルから -2 semitone shift で機械生成 (tools 不要、 値は確認済): new[i] = old[max(0,i-2)]。
; ====================================================================================================

music_divmod12_opm:
.db 0x00, 0x00, 0x00, 0x00, 0x01, 0x02, 0x04, 0x05, 0x06, 0x08, 0x09, 0x0a, 0x0c, 0x0d, 0x0e, 0x10
.db 0x11, 0x12, 0x14, 0x15, 0x16, 0x18, 0x19, 0x1a, 0x1c, 0x1d, 0x1e, 0x20, 0x21, 0x22, 0x24, 0x25
.db 0x26, 0x28, 0x29, 0x2a, 0x2c, 0x2d, 0x2e, 0x30, 0x31, 0x32, 0x34, 0x35, 0x36, 0x38, 0x39, 0x3a
.db 0x3c, 0x3d, 0x3e, 0x40, 0x41, 0x42, 0x44, 0x45, 0x46, 0x48, 0x49, 0x4a, 0x4c, 0x4d, 0x4e, 0x50
.db 0x51, 0x52, 0x54, 0x55, 0x56, 0x58, 0x59, 0x5a, 0x5c, 0x5d, 0x5e, 0x60, 0x61, 0x62, 0x64, 0x65
.db 0x66, 0x68, 0x69, 0x6a, 0x6c, 0x6d, 0x6e, 0x70, 0x71, 0x72, 0x74, 0x75, 0x76, 0x78, 0x79, 0x7a
.db 0x7c, 0x7d, 0x7e, 0x80, 0x81, 0x82, 0x84, 0x85, 0x86, 0x88, 0x89, 0x8a, 0x8c, 0x8d, 0x8e, 0x90
.db 0x91, 0x92, 0x94, 0x95, 0x96, 0x98, 0x99, 0x9a, 0x9c, 0x9d, 0x9e, 0xa0, 0xa1, 0xa2, 0xa4, 0xa5
