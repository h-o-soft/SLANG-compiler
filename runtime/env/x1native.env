env_type: 1
os_type: 4
defines:
  X1NATIVE: 1
default_org:	"$1000"
output: bin
# Phase B: X1 tape (.tap / .wav) 出力 default (= slangbuild --emit tape)。
# CLI --tape-name / --tape-load / --tape-exec で override 可能。
tape:
  name: "PROG"
  load: "$1000"
  exec: "$1000"
  # wav_sample_rate: 48000  # default
  # wav_bits: 8             # default
libraries:
  - runtime.yml
  - libfloat.yml
  - libx1native_base.yml
  - libx1native_input.yml
  - libx1native_print.yml
  - libx1_base.yml
  - libcompress.yml
  - libsoroban.yml
