env_type: 1
os_type: 4
defines:
  X1NATIVE: 1
default_org:	"$1000"
output: bin
# Phase B: X1 tape (.tap / .wav) 出力 default (= slangbuild --emit tape)。
# CLI --tape-name / --tape-load / --tape-exec で override 可能。
tape:
  name: "PROG"
  load: "$1000"
  exec: "$1000"
  # wav_sample_rate: 48000  # default
  # wav_bits: 8             # default
libraries:
  - runtime.yml
  - libfloat.yml
  - libx1native_base.yml
  - libx1native_input.yml
  - libx1native_print.yml
  - libx1_base.yml
  # graphics 系 reuse (= 既存 libx1_* asm、 LSX 直接依存 0 件で x1native でも動く)
  - libx1_pcg.yml       # supported now (= PCGDEF / PCGDEFS、 X1GRP/STARS_X1 で使用)
  - libx1_grp.yml       # supported now (= LINE / PAINT / BFILL / GRPSETUP 等、 X1GRP で使用)
  - libx1_magic.yml     # registered (= 未使用時は selective link で無害、 動作確認は別 PR)
  - libx1_sgl.yml       # supported now (= SGL_* sprite、 X1SGL.SL で動作確認、 sgl_lsx は除外)
  - libx1_psg.yml       # supported now (= PSG_INIT(0)/(1) 両対応、 自前 IM2 vector で割り込み駆動)
  - libx1native_tape.yml  # supported now (= MTREAD/MTREADJP 多段 tape load + sub CPU deck control)
  - libcompress.yml
  - libsoroban.yml
  - libx1_arkos.yml       # Arkos Tracker driver (AKG/AKM 共通) MACHINE 中間層 (= x1native trampoline 経由 RETI)
