env_type: 2
os_type: 1
default_org:	"$3000"
libraries:
  - runtime.yml
  - libfloat.yml
  - libsosx1_base.yml
  - libsos_input.yml
  - libsos_print.yml
  - libsos_file.yml
  - libsos_pcg.yml
  - libx1_grp.yml
  - libmag.yml
  - libm8a.yml
  - libx1_base.yml
  - libx1_psg.yml
  - libcompress.yml
  - libsoroban.yml
  - libx1_magic.yml
  - libx1_sgl.yml
  - libx1_arkos.yml       # Arkos Tracker driver (AKG/AKM 共通) MACHINE 中間層
  - libx1_banjo.yml       # banjo Furnace tracker driver (AY/OPM 共通) MACHINE 中間層
disk:
  format: d88
  template: ../../images/templates/SOSPROG.D88
  tool: hudisk
  main_name: PROG.bin
  main_load: "$3000"
  main_exec: "$3000"
  overlay_name: M{index}.BIN
  overlay_load: "$3000"
