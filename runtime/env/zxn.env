env_type: 6
os_type: 5
default_org:	"$8000"
default_work: "$D000"
stack_top: "$E000"
# プログラム (コード・WORK・スタック) を置いてよい範囲。FD00H〜FFFFH は Next の SLANG IDE の予約域 (戻り口と割り込みの表)。
# slangbuild が組んだ後に、コード・WORK・スタック (__STACKTOP − stack_size を 16 バイトに切り下げた所から) が
# この範囲に収まり、重ならないことを調べる (IDE のリンク時の検査と同じ)
area_start: "$8000"
area_end: "$FD00"
stack_size: 1024
libraries:
  - runtime.yml
  - libfloat.yml
  - libzxn_base.yml
  - libzxn_print.yml
  - libzxn_input.yml
  - libzxn_file.yml
  - libzxn_nextdaw.yml
  - libzxn_norom.yml
# ROM を使わない版の断片 (libzxn_norom の名前__NOROM) を、ソースの CONST __NOROM = 1; で使う
norom: true
# 0000H〜3FFFH を RAM にする版 (libzxn_norom の名前__LOWRAM) を、ソースの CONST __LOWRAM = ページ; (と CONST __NOROM = 1;) で使う
lowram: true
# この機械にある機能。部品の @requires がここに無ければ、使ったときにエラー (zxs で Next の部品を使ったときなど)
features: [next]
# #MODULE $addr PAGE n (モジュールを 8K のページに入れる。窓の検査は slangc と slangbuild)
module_pages: true
# slangbuild --emit nex で NEX を書く (本体・PAGE のモジュール・//#PAGE のデータ)
nex: true
