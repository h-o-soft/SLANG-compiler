env_type: 0
os_type: 0
default_org:	"$100"
libraries:
  - runtime.yml
  - libfloat.yml
  - liblsx_base.yml
  - liblsx_input.yml
  - liblsx_print.yml
  - liblsx_file.yml
  - libx1_base.yml
  - libx1_psg.yml
  - libcompress.yml
  - libsoroban.yml
  - libx1_magic.yml
disk:
  format: d88
  template: ../../images/LSXPROG.D88
  tool: ndc
  main_name: PROG.COM
  overlay_name: M{index}.BIN
