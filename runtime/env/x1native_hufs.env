env_type: 1
os_type: 4
defines:
  X1NATIVE: 1
  HUFS: 1
default_org:	"$1000"
output: bin
# x1native HUFS = Hu-BASIC (CZ-8FB01) と同じ形の 2D ディスク (D88)。ファイルを名前で読み書きする (docs/HUFS.md)。
# slangbuild --emit disk で hufs-pack (slfs-pack の hu) 経由で D88 を出す。
# x1native_slfs.env の写しで、libx1native_slfs.yml の代わりに libx1native_hufs.yml を使う
# (slfs の FS_READ_BY_ID などは Hu の形のディスクを読み壊すので、この環境ではリンクさせない)。
# 注意 (env の include の仕組みがない): x1native.env・x1native_slfs.env の libraries を変えたら、こちらも合わせる。
disk:
  format: d88
  tool: hufs-pack
  main_name: "HUFSMAIN"
  main_load: "$1000"
  main_exec: "$1000"
libraries:
  - runtime.yml
  - libfloat.yml
  - libx1native_base.yml
  - libx1native_input.yml
  - libx1native_print.yml
  - libx1_base.yml
  - libx1_pcg.yml
  - libx1_grp.yml
  - libx1_magic.yml
  - libx1_sgl.yml
  - libx1_psg.yml
  - libx1native_hufs.yml  # HUFS (Hu-BASIC と同じ形のディスク。FRAWREAD など)
  - libcompress.yml
  - libsoroban.yml
  - libx1_arkos.yml       # Arkos Tracker driver (AKG/AKM 共通) MACHINE 中間層
  - libx1_banjo.yml       # banjo Furnace tracker driver (AY/OPM 共通) MACHINE 中間層
  - libx1_basic.yml      # X1 BASIC 系ライブラリ (BAS_ 関数、hubasic2sl の出力が使う。選択リンクなので未使用なら無害)
