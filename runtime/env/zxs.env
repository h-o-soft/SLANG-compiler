# 素の ZX Spectrum (48K の機械として動くもの。48K・128K・+2・+2A・+3 で、BASIC の読み込み口から起動する)
env_type: 8
os_type: 7
default_org: "$8000"
default_work: "$D000"
# FDFDH〜FF00H は割り込みの表と処理 (SLANGINIT__ZXS の素の Z80 の IM 2)
stack_top: "$FD00"
# プログラム (コード・WORK・スタック) を置いてよい範囲 (slangbuild が組んだ後に調べる。#278 と同じ)
area_start: "$8000"
area_end: "$FD00"
stack_size: 1024
libraries:
  - runtime.yml
  - libfloat.yml
  - libzxn_base.yml
  - libzxn_print.yml
  - libzxn_input.yml
  - libzxn_file.yml
  - libzxn_nextdaw.yml
  - libzxn_norom.yml
  - libzxs.yml
# zxn の部品の X を、いつも X__NOROM の後で X__ZXS に差し替える (ROM を使わない GETC・PRT の番地の計算、ROM の字、素の IM 2)
variants: [__NOROM, __ZXS]
# Next の機能は無い。@requires next の部品 (Layer 2・スプライト・ファイルなど) を使うとエラー
features: []
# slangbuild --emit tape で TAP と TZX (BASIC の読み込み口 + CODE)
tape:
  format: zx
