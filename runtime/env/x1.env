env_type: 1
os_type: 0
default_org:	"$100"
libraries:
  - runtime.yml
  - libfloat.yml
  - liblsx_base.yml
  - libx1_base.yml
  - libx1_grp.yml
  - liblsx_input.yml
  - libx1_print.yml
  - liblsx_file.yml
  - libx1_pcg.yml
  - libmag.yml
  - libm8a.yml
  - libx1_psg.yml
  - libcompress.yml
  - libsoroban.yml
  - libx1_magic.yml
  - libx1_sgl_lsx.yml
  - libx1_arkos.yml       # Arkos Tracker driver (AKG/AKM 共通) MACHINE 中間層 (= 動的 link、 driver bin は実行時ロード)
disk:
  format: d88
  template: ../../images/templates/LSXPROG.D88
  tool: ndc
  main_name: PROG.COM
  overlay_name: M{index}.BIN
