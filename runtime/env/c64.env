env_type: 7
os_type: 6
backend: oscar_c
output: c_source
oscar_machine: c64
oscar_format: prg
oscar_petscii: true
# oscar64 最適化レベルを Os (= size 最適化、O2 相当の速度最適化も含む) に固定。
# 既定 -O1 では bitwise AND (`IF N AND $8000` 等) を含む特定の最適化パスで
# constant fold が partial に効いて誤った分岐評価をする bug を踏むため、回避策
# として Os を採用する (= O0/O2/O3/Os では未再現、O1 のみ発火)。size 面でも
# O1 より小さくなるため副作用なし。oscar64 側修正されたら本行を削除する想定。
# 追跡: examples/c64/HISCORE.SL の `IF N AND $8000` で初めて顕在化。
oscar_optimize: Os
c_runtime_files:
  - ../c64/slang_runtime.c
  - ../c64/slang_sprite.c
  - ../c64/slang_joystick.c
  - ../c64/slang_kio.c
c_runtime_includes:
  - ../c64

# === Standard C64 API binding (env が提供、SLANG 側で CFUNC 宣言不要) ===
# bridge 関数は runtime/c64/slang_sprite.c に実装。oscar64 sprites.h API を
# SLANG WORD 経由で呼べるよう型整合と pointer table 管理を吸収。
c_bindings:
  # SPR_INIT(screen_addr) — screen RAM 先頭 ($0400 等) を渡す。
  - name: SPR_INIT
    c_name: slang_spr_init
    params: [word]
    return: void

  # SPR_SET(sp, show, x, y, image, color, multi, xex, yex) — sprite N の
  # 有効化 + 位置 + イメージ + 色 + multi/xexpand/yexpand フラグまとめて設定。
  # show/multi/xex/yex は SLANG BYTE で 0/非0 (= bool 相当)。
  - name: SPR_SET
    c_name: slang_spr_set
    params: [byte, byte, word, word, byte, byte, byte, byte, byte]
    return: void

  # SPR_MOVE(sp, x, y) — 位置のみ更新 (= 移動ループの hot path)
  - name: SPR_MOVE
    c_name: slang_spr_move
    params: [byte, word, word]
    return: void

  # SPR_SHOW(sp, show) — 有効/無効切替 (= bool show)
  - name: SPR_SHOW
    c_name: slang_spr_show
    params: [byte, byte]
    return: void

  # SPR_POSX / SPR_POSY(sp) — 現在位置取得
  - name: SPR_POSX
    c_name: slang_spr_posx
    params: [byte]
    return: word
  - name: SPR_POSY
    c_name: slang_spr_posy
    params: [byte]
    return: word

  # SPR_COLOR(sp, color) — 色変更のみ
  - name: SPR_COLOR
    c_name: slang_spr_color
    params: [byte, byte]
    return: void

  # SPR_IMAGE(sp, image) — image block (0..255) 切替 (pointer table 反映込み)
  - name: SPR_IMAGE
    c_name: slang_spr_image
    params: [byte, byte]
    return: void

  # VIC_WAIT() — VSYNC 待ち (1 フレーム同期、tearing 防止)
  - name: VIC_WAIT
    c_name: slang_vic_wait_frame
    params: []
    return: void

  # === Joystick (oscar64 joystick.h) ===
  # JOY_POLL は 1 frame 1 回呼び、JOY_X/Y/B/DIR で状態を読む。
  # JOY_X/Y は signed (-1/0/1) を SLANG WORD で -1=$FFFF として返す。
  # JOY_DIR は include/C64_JOY.LIB の bitmask 定数と整合する 5 bit mask。
  - name: JOY_POLL
    c_name: slang_joy_poll
    params: [byte]
    return: void
  - name: JOY_X
    c_name: slang_joy_x
    params: [byte]
    return: word
  - name: JOY_Y
    c_name: slang_joy_y
    params: [byte]
    return: word
  - name: JOY_B
    c_name: slang_joy_b
    params: [byte]
    return: word
  - name: JOY_DIR
    c_name: slang_joy_dir
    params: [byte]
    return: word

  # === KERNAL file I/O (oscar64 kernalio.h) ===
  # 文字列は NUL terminated PETSCII 固定 (= oscar64 -psci で SLANG
  # リテラル "HISCORE,S,R" がそのまま渡る)。通常 API は byte_ptr 主、
  # raw address 用は KIO_*_ADDR 別関数。
  # 戻り値の慣行: bool 系は 0/1、byte 系は 0..255、getch/read/write/
  # gets/puts は signed int を返すので SLANG WORD では負値が $FFFx で
  # 届く (= sign extension で OK、判定パターンは README/sample 参照)。
  - name: KIO_SETNAM
    c_name: slang_kio_setnam
    params: [byte_ptr]
    return: void
  - name: KIO_OPEN
    c_name: slang_kio_open
    params: [byte, byte, byte]
    return: word
  - name: KIO_OPEN_NAMED
    c_name: slang_kio_open_named
    params: [byte, byte, byte, byte_ptr]
    return: word
  - name: KIO_CLOSE
    c_name: slang_kio_close
    params: [byte]
    return: void
  - name: KIO_CHKIN
    c_name: slang_kio_chkin
    params: [byte]
    return: word
  - name: KIO_CHKOUT
    c_name: slang_kio_chkout
    params: [byte]
    return: word
  - name: KIO_CLRCHN
    c_name: slang_kio_clrchn
    params: []
    return: void
  - name: KIO_CHRIN
    c_name: slang_kio_chrin
    params: []
    return: word
  - name: KIO_CHROUT
    c_name: slang_kio_chrout
    params: [word]
    return: word
  - name: KIO_GETCH
    c_name: slang_kio_getch
    params: [byte]
    return: word
  - name: KIO_PUTCH
    c_name: slang_kio_putch
    params: [byte, word]
    return: word
  - name: KIO_READ
    c_name: slang_kio_read
    params: [byte, byte_ptr, word]
    return: word
  - name: KIO_WRITE
    c_name: slang_kio_write
    params: [byte, byte_ptr, word]
    return: word
  - name: KIO_PUTS
    c_name: slang_kio_puts
    params: [byte, byte_ptr]
    return: word
  - name: KIO_GETS
    c_name: slang_kio_gets
    params: [byte, byte_ptr, word]
    return: word
  - name: KIO_STATUS
    c_name: slang_kio_status
    params: []
    return: word

  # raw address 版 (= 通常 byte_ptr 版で済むなら不要、SLANG コードで明示的に
  # 絶対アドレスを使う高度なケース向け)
  - name: KIO_SETNAM_ADDR
    c_name: slang_kio_setnam_addr
    params: [word]
    return: void
  - name: KIO_OPEN_NAMED_ADDR
    c_name: slang_kio_open_named_addr
    params: [byte, byte, byte, word]
    return: word
  - name: KIO_READ_ADDR
    c_name: slang_kio_read_addr
    params: [byte, word, word]
    return: word
  - name: KIO_WRITE_ADDR
    c_name: slang_kio_write_addr
    params: [byte, word, word]
    return: word

  # INPUT / GETL / GETLIN / LINPUT (SLANG Z80 backend と signature 互換)
  # ESC キーで $FFFF を返す。Z80 backend の `_CARRY` 機構は v1 未対応。
  - name: INPUT
    c_name: slang_input
    params: []
    return: word
  - name: GETL
    c_name: slang_getl
    params: [word]
    return: word
  - name: GETLIN
    c_name: slang_getlin
    params: [word, word]
    return: word
  - name: LINPUT
    c_name: slang_linput
    params: [word, word]
    return: word
