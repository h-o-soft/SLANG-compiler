env_type: 7
os_type: 6
backend: oscar_c
output: c_source
oscar_machine: c64
oscar_format: prg
oscar_petscii: true
# oscar64 最適化レベルを Os (= size 最適化、O2 相当の速度最適化も含む) に固定。
# 既定 -O1 では bitwise AND (`IF N AND $8000` 等) を含む特定の最適化パスで
# constant fold が partial に効いて誤った分岐評価をする bug を踏むため、回避策
# として Os を採用する (= O0/O2/O3/Os では未再現、O1 のみ発火)。size 面でも
# O1 より小さくなるため副作用なし。oscar64 側修正されたら本行を削除する想定。
# 追跡: examples/c64/HISCORE.SL の `IF N AND $8000` で初めて顕在化。
oscar_optimize: Os
c_runtime_files:
  - ../c64/slang_runtime.c
  - ../c64/slang_sprite.c
  - ../c64/slang_joystick.c
  - ../c64/slang_kio.c
  - ../c64/slang_sid.c
  - ../c64/slang_sidfx.c
  # v0.25.0: 最低限ゲーム作成 API (= mmap / vic_setmode / memcpy)
  - ../c64/slang_memmap.c
  - ../c64/slang_vic.c
  - ../c64/slang_mem.c
c_runtime_includes:
  - ../c64

# === Standard C64 API binding (env が提供、SLANG 側で CFUNC 宣言不要) ===
# bridge 関数は runtime/c64/slang_sprite.c に実装。oscar64 sprites.h API を
# SLANG WORD 経由で呼べるよう型整合と pointer table 管理を吸収。
c_bindings:
  # SPR_INIT(screen_addr) — screen RAM 先頭 ($0400 等) を渡す。
  - name: SPR_INIT
    c_name: slang_spr_init
    params: [word]
    return: void

  # SPR_SET(sp, show, x, y, image, color, multi, xex, yex) — sprite N の
  # 有効化 + 位置 + イメージ + 色 + multi/xexpand/yexpand フラグまとめて設定。
  # show/multi/xex/yex は SLANG BYTE で 0/非0 (= bool 相当)。
  - name: SPR_SET
    c_name: slang_spr_set
    params: [byte, byte, word, word, byte, byte, byte, byte, byte]
    return: void

  # SPR_MOVE(sp, x, y) — 位置のみ更新 (= 移動ループの hot path)
  - name: SPR_MOVE
    c_name: slang_spr_move
    params: [byte, word, word]
    return: void

  # SPR_SHOW(sp, show) — 有効/無効切替 (= bool show)
  - name: SPR_SHOW
    c_name: slang_spr_show
    params: [byte, byte]
    return: void

  # SPR_POSX / SPR_POSY(sp) — 現在位置取得
  - name: SPR_POSX
    c_name: slang_spr_posx
    params: [byte]
    return: word
  - name: SPR_POSY
    c_name: slang_spr_posy
    params: [byte]
    return: word

  # SPR_COLOR(sp, color) — 色変更のみ
  - name: SPR_COLOR
    c_name: slang_spr_color
    params: [byte, byte]
    return: void

  # SPR_IMAGE(sp, image) — image block (0..255) 切替 (pointer table 反映込み)
  - name: SPR_IMAGE
    c_name: slang_spr_image
    params: [byte, byte]
    return: void

  # VIC_WAIT() — VSYNC 待ち (1 フレーム同期、tearing 防止)
  - name: VIC_WAIT
    c_name: slang_vic_wait_frame
    params: []
    return: void

  # === Joystick (oscar64 joystick.h) ===
  # JOY_POLL は 1 frame 1 回呼び、JOY_X/Y/B/DIR で状態を読む。
  # JOY_X/Y は signed (-1/0/1) を SLANG WORD で -1=$FFFF として返す。
  # JOY_DIR は include/C64_JOY.LIB の bitmask 定数と整合する 5 bit mask。
  - name: JOY_POLL
    c_name: slang_joy_poll
    params: [byte]
    return: void
  - name: JOY_X
    c_name: slang_joy_x
    params: [byte]
    return: word
  - name: JOY_Y
    c_name: slang_joy_y
    params: [byte]
    return: word
  - name: JOY_B
    c_name: slang_joy_b
    params: [byte]
    return: word
  - name: JOY_DIR
    c_name: slang_joy_dir
    params: [byte]
    return: word

  # === KERNAL file I/O (oscar64 kernalio.h) ===
  # 文字列は NUL terminated PETSCII 固定 (= oscar64 -psci で SLANG
  # リテラル "HISCORE,S,R" がそのまま渡る)。通常 API は byte_ptr 主、
  # raw address 用は KIO_*_ADDR 別関数。
  # 戻り値の慣行: bool 系は 0/1、byte 系は 0..255、getch/read/write/
  # gets/puts は signed int を返すので SLANG WORD では負値が $FFFx で
  # 届く (= sign extension で OK、判定パターンは README/sample 参照)。
  - name: KIO_SETNAM
    c_name: slang_kio_setnam
    params: [byte_ptr]
    return: void
  - name: KIO_OPEN
    c_name: slang_kio_open
    params: [byte, byte, byte]
    return: word
  - name: KIO_OPEN_NAMED
    c_name: slang_kio_open_named
    params: [byte, byte, byte, byte_ptr]
    return: word
  - name: KIO_CLOSE
    c_name: slang_kio_close
    params: [byte]
    return: void
  - name: KIO_CHKIN
    c_name: slang_kio_chkin
    params: [byte]
    return: word
  - name: KIO_CHKOUT
    c_name: slang_kio_chkout
    params: [byte]
    return: word
  - name: KIO_CLRCHN
    c_name: slang_kio_clrchn
    params: []
    return: void
  - name: KIO_CHRIN
    c_name: slang_kio_chrin
    params: []
    return: word
  - name: KIO_CHROUT
    c_name: slang_kio_chrout
    params: [word]
    return: word
  - name: KIO_GETCH
    c_name: slang_kio_getch
    params: [byte]
    return: word
  - name: KIO_PUTCH
    c_name: slang_kio_putch
    params: [byte, word]
    return: word
  - name: KIO_READ
    c_name: slang_kio_read
    params: [byte, byte_ptr, word]
    return: word
  - name: KIO_WRITE
    c_name: slang_kio_write
    params: [byte, byte_ptr, word]
    return: word
  - name: KIO_PUTS
    c_name: slang_kio_puts
    params: [byte, byte_ptr]
    return: word
  - name: KIO_GETS
    c_name: slang_kio_gets
    params: [byte, byte_ptr, word]
    return: word
  - name: KIO_STATUS
    c_name: slang_kio_status
    params: []
    return: word

  # raw address 版 (= 通常 byte_ptr 版で済むなら不要、SLANG コードで明示的に
  # 絶対アドレスを使う高度なケース向け)
  - name: KIO_SETNAM_ADDR
    c_name: slang_kio_setnam_addr
    params: [word]
    return: void
  - name: KIO_OPEN_NAMED_ADDR
    c_name: slang_kio_open_named_addr
    params: [byte, byte, byte, word]
    return: word
  - name: KIO_READ_ADDR
    c_name: slang_kio_read_addr
    params: [byte, word, word]
    return: word
  - name: KIO_WRITE_ADDR
    c_name: slang_kio_write_addr
    params: [byte, word, word]
    return: word

  # === SID register direct + 単発 SFX (oscar64 c64/sid.h、v3b-A) ===
  # SID register を直接叩く API + SFX wrapper。HVSC .sid 取り込みは v3b-B、
  # priority SFX overlay は v3b-C で追加予定。
  # voice 番号 0..2、volume 0..15。frequency は PAL clock 基準の register 値
  # (= NOTE_C4 等の事前計算済定数を C64_SID.LIB から取得して渡す)。
  # waveform / ADSR / CTRL の bit 構成は C64_SID.LIB の SID_WF_* / SID_ATK_*
  # / SID_DKY_* / SID_SUS_* / SID_CTRL_* 定数で組み立てる。
  - name: SID_INIT_QUIET
    c_name: slang_sid_init_quiet
    params: []
    return: void
  - name: SID_VOLUME
    c_name: slang_sid_volume
    params: [byte]
    return: void
  - name: SID_FREQ
    c_name: slang_sid_freq
    params: [byte, word]
    return: void
  - name: SID_PWM
    c_name: slang_sid_pwm
    params: [byte, word]
    return: void
  - name: SID_ADSR
    c_name: slang_sid_adsr
    params: [byte, byte, byte]
    return: void
  - name: SID_CTRL
    c_name: slang_sid_ctrl
    params: [byte, byte]
    return: void
  - name: SID_GATE_ON
    c_name: slang_sid_gate_on
    params: [byte]
    return: void
  - name: SID_GATE_OFF
    c_name: slang_sid_gate_off
    params: [byte]
    return: void
  - name: SID_SFX
    c_name: slang_sid_sfx
    params: [byte, word, byte, byte, byte]
    return: void

  # === HVSC .sid disk load + BGM 再生 (v3b-B) ===
  # KIO 経由で disk から .sid file を読み込み、PSID header parse + payload を
  # loadAddress に memcpy + init/play addr を bridge 内 static 保持して player
  # 再生する。tune 自体は SLANG repo に同梱しない (= user が HVSC 等から手元で
  # 取得して D64 に入れる前提、license は user 責務)。
  # PSID v2 only (= RSID 非対応)、シングル SID のみ (= multi-SID 非対応)、
  # PAL 50Hz 想定 (= VIC_WAIT 連動)。
  - name: SID_LOAD_FROM_BUF
    c_name: slang_sid_load_from_buf
    params: [byte_ptr, word]
    return: word
  - name: SID_PLAYER_INIT
    c_name: slang_sid_player_init
    params: [byte]
    return: void
  - name: SID_PLAYER_PLAY
    c_name: slang_sid_player_play
    params: []
    return: void
  - name: SID_PLAYER_READY
    c_name: slang_sid_player_ready
    params: []
    return: word
  # raw address 版 (= SLANG ARRAY BYTE 経由だと oscar64 BSS が $1000 領域を
  # 占有して HVSC tune (loadAddr $1000) と衝突するため、KIO_READ_ADDR で
  # $C000 等の free RAM に直接 disk read してから本関数に渡す)
  - name: SID_LOAD_FROM_BUF_ADDR
    c_name: slang_sid_load_from_buf_addr
    params: [word, word]
    return: word

  # === oscar64 audio/sidfx priority SFX overlay (v3b-C) ===
  # SIDFX struct array (= 14 byte fixed) を SLANG ARRAY BYTE で組み立てて
  # byte_ptr で渡す。oscar64 audio/sidfx.h declaration を bridge 参照 (= GPL
  # 同梱回避)、 audio/sidfx.c 実体は user の oscar64 install からリンク時解決。
  # voice chn は 0..2、 priority は 0..255 (高いほど上書きしやすい)。
  - name: SIDFX_INIT
    c_name: slang_sidfx_init
    params: []
    return: void
  - name: SIDFX_PLAY
    c_name: slang_sidfx_play
    params: [byte, byte_ptr, byte]
    return: void
  - name: SIDFX_STOP
    c_name: slang_sidfx_stop
    params: [byte]
    return: void
  - name: SIDFX_IDLE
    c_name: slang_sidfx_idle
    params: [byte]
    return: word
  - name: SIDFX_CNT
    c_name: slang_sidfx_cnt
    params: [byte]
    return: word
  - name: SIDFX_LOOP
    c_name: slang_sidfx_loop
    params: []
    return: void
  - name: SIDFX_LOOP_2
    c_name: slang_sidfx_loop_2
    params: []
    return: void

  # INPUT / GETL / GETLIN / LINPUT (SLANG Z80 backend と signature 互換)
  # ESC キーで $FFFF を返す。Z80 backend の `_CARRY` 機構は v1 未対応。
  - name: INPUT
    c_name: slang_input
    params: []
    return: word
  - name: GETL
    c_name: slang_getl
    params: [word]
    return: word
  - name: GETLIN
    c_name: slang_getlin
    params: [word, word]
    return: word
  - name: LINPUT
    c_name: slang_linput
    params: [word, word]
    return: word

  # === v0.25.0: 最低限ゲーム作成 API ===
  # bridge は runtime/c64/slang_memmap.c / slang_vic.c / slang_mem.c に実装、
  # oscar64 c64/memmap.h / c64/vic.h / string.h 経由の薄い wrapper。

  # memmap (= memory map switching、 oscar64 c64/memmap.h)
  - name: MMAP_SET
    c_name: slang_mmap_set
    params: [byte]
    return: byte         # 旧 mmap 値 (= 復元用、 oscar64 spec 通り)
  - name: MMAP_TRAMPOLINE
    c_name: slang_mmap_trampoline
    params: []
    return: void

  # vic (= VIC-II video chip、 oscar64 c64/vic.h)
  - name: VIC_SETMODE
    c_name: slang_vic_setmode
    params: [byte, word, word]    # mode, screen_addr, font_addr
    return: void
  - name: VIC_SETBANK
    c_name: slang_vic_setbank
    params: [byte]
    return: void

  # mem (= 標準 memcpy/memset、 oscar64 string.h)
  # caveat: 現在の CPU memory map に従う。 $D000-$DFFF は mmap 状態次第で
  # I/O / CHAR ROM / RAM が切替わるため、 想定 memory layout 確認後に呼ぶこと。
  - name: MEMCPY
    c_name: slang_memcpy
    params: [word, word, word]    # dst, src, size
    return: void
  - name: MEMSET
    c_name: slang_memset
    params: [word, byte, word]    # dst, value, size
    return: void
