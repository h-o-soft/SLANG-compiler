env_type: 7
os_type: 6
backend: oscar_c
output: c_source
oscar_machine: c64
oscar_format: prg
oscar_petscii: true
c_runtime_files:
  - ../c64/slang_runtime.c
  - ../c64/slang_sprite.c
  - ../c64/slang_joystick.c
c_runtime_includes:
  - ../c64

# === Standard C64 API binding (env が提供、SLANG 側で CFUNC 宣言不要) ===
# bridge 関数は runtime/c64/slang_sprite.c に実装。oscar64 sprites.h API を
# SLANG WORD 経由で呼べるよう型整合と pointer table 管理を吸収。
c_bindings:
  # SPR_INIT(screen_addr) — screen RAM 先頭 ($0400 等) を渡す。
  - name: SPR_INIT
    c_name: slang_spr_init
    params: [word]
    return: void

  # SPR_SET(sp, show, x, y, image, color, multi, xex, yex) — sprite N の
  # 有効化 + 位置 + イメージ + 色 + multi/xexpand/yexpand フラグまとめて設定。
  # show/multi/xex/yex は SLANG BYTE で 0/非0 (= bool 相当)。
  - name: SPR_SET
    c_name: slang_spr_set
    params: [byte, byte, word, word, byte, byte, byte, byte, byte]
    return: void

  # SPR_MOVE(sp, x, y) — 位置のみ更新 (= 移動ループの hot path)
  - name: SPR_MOVE
    c_name: slang_spr_move
    params: [byte, word, word]
    return: void

  # SPR_SHOW(sp, show) — 有効/無効切替 (= bool show)
  - name: SPR_SHOW
    c_name: slang_spr_show
    params: [byte, byte]
    return: void

  # SPR_POSX / SPR_POSY(sp) — 現在位置取得
  - name: SPR_POSX
    c_name: slang_spr_posx
    params: [byte]
    return: word
  - name: SPR_POSY
    c_name: slang_spr_posy
    params: [byte]
    return: word

  # SPR_COLOR(sp, color) — 色変更のみ
  - name: SPR_COLOR
    c_name: slang_spr_color
    params: [byte, byte]
    return: void

  # SPR_IMAGE(sp, image) — image block (0..255) 切替 (pointer table 反映込み)
  - name: SPR_IMAGE
    c_name: slang_spr_image
    params: [byte, byte]
    return: void

  # VIC_WAIT() — VSYNC 待ち (1 フレーム同期、tearing 防止)
  - name: VIC_WAIT
    c_name: slang_vic_wait_frame
    params: []
    return: void

  # === Joystick (oscar64 joystick.h) ===
  # JOY_POLL は 1 frame 1 回呼び、JOY_X/Y/B/DIR で状態を読む。
  # JOY_X/Y は signed (-1/0/1) を SLANG WORD で -1=$FFFF として返す。
  # JOY_DIR は include/C64_JOY.LIB の bitmask 定数と整合する 5 bit mask。
  - name: JOY_POLL
    c_name: slang_joy_poll
    params: [byte]
    return: void
  - name: JOY_X
    c_name: slang_joy_x
    params: [byte]
    return: word
  - name: JOY_Y
    c_name: slang_joy_y
    params: [byte]
    return: word
  - name: JOY_B
    c_name: slang_joy_b
    params: [byte]
    return: word
  - name: JOY_DIR
    c_name: slang_joy_dir
    params: [byte]
    return: word

  # INPUT / GETL / GETLIN / LINPUT (SLANG Z80 backend と signature 互換)
  # ESC キーで $FFFF を返す。Z80 backend の `_CARRY` 機構は v1 未対応。
  - name: INPUT
    c_name: slang_input
    params: []
    return: word
  - name: GETL
    c_name: slang_getl
    params: [word]
    return: word
  - name: GETLIN
    c_name: slang_getlin
    params: [word, word]
    return: word
  - name: LINPUT
    c_name: slang_linput
    params: [word, word]
    return: word
