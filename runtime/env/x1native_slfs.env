env_type: 1
os_type: 4
defines:
  X1NATIVE: 1
default_org:	"$1000"
output: bin
# x1native SLFS = HuBASIC IPL 互換 boot + 独自 file system (= D88 disk image)。
# slangbuild --emit disk で slfs-pack 経由 D88 出力。
# 注意 (= env include 機構未実装): 本 env は x1native.env の disk variant、
# 同期注意 (= libraries list / defines drift しないよう x1native.env と一緒に更新する)。
# 将来的 env include 検討は別 issue。
disk:
  format: d88
  tool: slfs-pack
  main_name: "SLFSMAIN"
  main_load: "$1000"
  main_exec: "$1000"
  volume: "SLFS DEMO"
libraries:
  - runtime.yml
  - libfloat.yml
  - libx1native_base.yml
  - libx1native_input.yml
  - libx1native_print.yml
  - libx1_base.yml
  - libx1_pcg.yml
  - libx1_grp.yml
  - libx1_magic.yml
  - libx1_sgl.yml
  - libx1_psg.yml
  - libx1native_slfs.yml  # SLFS file system (= disk I/O、 FS_READ_BY_ID 等)
  - libcompress.yml
  - libsoroban.yml
