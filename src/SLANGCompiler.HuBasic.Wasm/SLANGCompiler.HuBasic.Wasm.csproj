<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    hubasic2sl の変換と slangc のコンパイルと Hu-BASIC の形のディスク作りを、ブラウザ (browser-wasm) で動かす入口。
    SLANGCompiler.sln には入れない (組み立てるのは scripts/build-hubasic-wasm.sh だけ)。
    HuBasic と SlfsPack は自己完結でない Exe なので ProjectReference にせず (NETSDK1151)、CLI の外側を除いたソースを共有する。
    Core (slangc の本体) はライブラリなので ProjectReference にする。
    env を読む YamlDotNet はリフレクションで型を作るので、刈り込み (trimming) で落ちないように Core と YamlDotNet を根にする。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>SLANGCompiler.HuBasic.Wasm</RootNamespace>
    <AssemblyName>hubasic2sl-wasm</AssemblyName>
    <Copyright>Copyright (c) 2022-2026 OGINO Hiroshi / H.O SOFT</Copyright>
    <Company>H.O SOFT</Company>
    <!-- HuBasic の csproj と同じ版にする (テストで比べる) -->
    <Version>0.1.0-alpha</Version>
    <AssemblyTitle>HuBASIC to SLANG transpiler (browser)</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SLANGCompiler.HuBasic/**/*.cs"
             Exclude="../SLANGCompiler.HuBasic/obj/**;../SLANGCompiler.HuBasic/bin/**;../SLANGCompiler.HuBasic/Program.cs;../SLANGCompiler.HuBasic/SlangbuildRunner.cs" />
    <Compile Include="../SLANGCompiler.SlfsPack/**/*.cs"
             Exclude="../SLANGCompiler.SlfsPack/obj/**;../SLANGCompiler.SlfsPack/bin/**;../SLANGCompiler.SlfsPack/Program.cs;../SLANGCompiler.SlfsPack/HuCommands.cs" />
    <Compile Include="HuBasicWeb.cs" />
    <Compile Include="SlangWeb.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SLANGCompiler.Core/SLANGCompiler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="SLANGCompiler.Core" />
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>
</Project>
